/target
**/*.rs.bk
# Cargo.lock is committed — this is a workspace with a binary.

# secrets / local config
config.toml
.env
.env.*
*.pem
*.key
wallet*.json
keypair*.json

# logs / state
*.log
sherwood.log*
/data
/state
*.db
*.db-shm
*.db-wal

# sqlx local dev database (the committed .sqlx/ offline cache is what CI uses)
crates/store/.sqlx-dev.db*

# frontend (package-lock.json IS committed — CI uses npm ci)
frontend/node_modules
frontend/dist
frontend/*.tsbuildinfo
frontend/.vite
