pragma solidity ^0.8.13;

// Dependency-free fork test that pins down the sherwood-dex V4_SWAP revert.
// No forge-std: only the cheatcodes used are declared; `forge test -vvvv`
// supplies the internal call trace.
//
// Root cause (found here): in `ExactInputSingleParams`, the `hookData`
// offset word was encoded as 9*32 (0x120) instead of 10*32 (0x140). It has
// to clear all ten head words -- the five PoolKey words, zeroForOne,
// amountIn, amountOutMinimum, minHopPriceX36, and the offset word itself.
// At 0x120 the offset points at itself; v4-periphery's CalldataDecoder then
// slices hookData out of bounds and does a bare revert(0,0) inside
// PoolManager.unlock -> UniversalRouter.unlockCallback, i.e. the exact
// empty-data revert that blocked v0.2.4. A real successful execute() tx
// pulled from the live chain (0xe9655a40...) encodes 0x140 here.
//
// GOOD  = calldata sherwood-dex emits AFTER the fix, for a 5 USDG -> NVDA
//         single-hop swap, from the wallet the live sim uses.
// BUGGY = the same bytes with word 27 reverted to 0x120 (pre-fix).

interface Vm {
    function createSelectFork(string calldata urlOrAlias, uint256 blockNumber) external returns (uint256);
    function startPrank(address) external;
    function stopPrank() external;
    function label(address, string calldata) external;
    function deal(address, uint256) external;
}

contract SwapReplayTest {
    Vm internal constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));

    address internal constant ROUTER = 0x8876789976dEcBfCbBbe364623C63652db8C0904;
    address internal constant CALLER = 0x6031775d3D2785b53D3e5438410E8830363E6cA1;
    address internal constant USDG   = 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168;
    address internal constant NVDA   = 0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC;

    // Block the post-fix live `sherwood dex-simulate` ran on.
    uint256 internal constant FORK_BLOCK = 59476229;

    bytes internal constant GOOD_CALLDATA  = hex"";
    bytes internal constant BUGGY_CALLDATA = hex"";

    event log_named_uint(string key, uint256 val);
    event log_named_bytes(string key, bytes val);

    function _fork() internal {
        vm.createSelectFork("https://rpc.mainnet.chain.robinhood.com", FORK_BLOCK);
        vm.label(ROUTER, "UniversalRouter");
        vm.label(CALLER, "caller");
        vm.label(USDG, "USDG");
        vm.label(NVDA, "NVDA");
        vm.deal(CALLER, 1 ether);
    }

    // The fix: exact calldata sherwood-dex now emits -> the swap simulates
    // clean against the live NVDA/USDG pool.
    function test_fixed_calldata_succeeds() external {
        _fork();
        vm.startPrank(CALLER);
        (bool ok, bytes memory ret) = ROUTER.call(GOOD_CALLDATA);
        vm.stopPrank();
        emit log_named_uint("ok (1=success)", ok ? 1 : 0);
        emit log_named_bytes("return data", ret);
        require(ok, "expected the fixed calldata to succeed");
    }

    // The bug: same swap, hookData offset back at 0x120 -> empty-data revert
    // inside unlockCallback, before the pool is ever touched.
    function test_buggy_offset_reverts_empty() external {
        _fork();
        vm.startPrank(CALLER);
        (bool ok, bytes memory ret) = ROUTER.call(BUGGY_CALLDATA);
        vm.stopPrank();
        emit log_named_uint("ok (1=success)", ok ? 1 : 0);
        emit log_named_uint("revert data length", ret.length);
        require(!ok, "expected the buggy offset to revert");
        require(ret.length == 0, "expected empty (0x) revert data");
    }
}
